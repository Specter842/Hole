# Copy to .env and fill in. .env is gitignored.

# Gemini is the default provider. Free key, no card required:
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Only needed if you set provider = "anthropic" in config.toml.
#   https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...

# Overrides [llm] provider in config.toml for one shell session.
# JOBSEARCH_LLM_PROVIDER=gemini

# Optional: use a database somewhere other than <project>/jobsearch.db
# JOBSEARCH_DB=C:\Users\you\Documents\jobsearch.db

# Basic-auth password for the web dashboard. Required to bind publicly
# (e.g. the Render deploy); optional for local 127.0.0.1 use.
# JOBSEARCH_PASSWORD=

# Point the app at a free hosted Turso DB instead of a local sqlite3 file --
# for hosts with no persistent disk (e.g. Render's free tier), where the local
# file would be wiped on every redeploy/spin-down. Get these from a free DB at
# https://turso.tech (turso db create, then turso db show / turso db tokens create).
# Leave both unset to use a local jobsearch.db as usual.
#
# Use https://, not the libsql:// scheme `turso db show` prints -- libsql://
# forces a WebSocket connection, which fails on some networks/hosts. https://
# talks to the same database over plain HTTP and works everywhere.
# TURSO_DATABASE_URL=https://your-db-name.turso.io
# TURSO_AUTH_TOKEN=
